{
  "name": "secure-notes",
  "version": "1.0.0",
  "private": true,
  "description": "A security-focused, server-rendered notes application.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:migrate": "node dist/scripts/start.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "notes",
    "security",
    "express",
    "postgresql"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "proxy-addr": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/proxy-addr": "^2.0.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
