NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://secure_notes:change-this-database-password@localhost:5432/secure_notes
DATABASE_SSL=disable

# Generate at least 32 random bytes, encode them, and keep them in a secret
# manager. For rotation, place the new secret first and retain the old one:
# SESSION_SECRETS=new-secret,old-secret
SESSION_SECRETS=
SESSION_TTL_MINUTES=480

# Development may use 0. Production requires the exact proxy count and CIDRs.
TRUST_PROXY_HOPS=0
# Explicit networks containing those proxies. Required when hops is nonzero.
# Example: TRUST_PROXY_CIDRS=10.20.0.0/16,2001:db8:1234::/48
TRUST_PROXY_CIDRS=
MAX_NOTES_PER_USER=100
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
